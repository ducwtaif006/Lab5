  "item": [
    {
      "name": "Positive_Cases (Happy Path)",
      "item": [
        {
          "name": "POST - Register User / Get Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token exists\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"token\");",
                  "});",
                  "",
                  "// Luu token vao bien moi truong userToken",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.environment.set(\"userToken\", body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"pistol\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST - Create User (Tích hợp Data-Driven Testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Du lieu cua iteration hien tai lay tu users.csv",
                  "const expectedName = pm.iterationData.get(\"name\");",
                  "const expectedJob  = pm.iterationData.get(\"job\");",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Da nap du lieu tu users.csv\", function () {",
                  "    pm.expect(expectedName, \"Chua chon file users.csv trong Runner\").to.not.be.undefined;",
                  "    pm.expect(expectedJob, \"Chua chon file users.csv trong Runner\").to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Response co name va job\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property(\"name\");",
                  "    pm.expect(res).to.have.property(\"job\");",
                  "});",
                  "",
                  "pm.test(\"name khop du lieu CSV\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(expectedName);",
                  "});",
                  "",
                  "pm.test(\"job khop du lieu CSV\", function () {",
                  "    pm.expect(pm.response.json().job).to.eql(expectedJob);",
                  "});",
                  "",
                  "// Luu id de PUT va DELETE dung o cac request sau",
                  "pm.environment.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"job\": \"{{job}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GET - Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"data.id equals 2\", function () {",
                  "    pm.expect(pm.response.json().data.id).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"data.email ends with @reqres.in\", function () {",
                  "    pm.expect(pm.response.json().data.email).to.include(\"@reqres.in\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/2",
              "host": [
                "{{baseUrl}}"
              ],
