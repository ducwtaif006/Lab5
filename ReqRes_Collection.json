                  "});",
                  "",
                  "pm.test(\"updatedAt exists in response body\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"updatedAt\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
